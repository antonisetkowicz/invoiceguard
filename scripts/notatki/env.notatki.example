# Fragment konfiguracji systemu /notatki.
#
# Dopisz zawartość tego pliku na koniec swojego `.env` w korzeniu repo:
#     cat scripts/notatki/env.notatki.example >> .env
#
# (Nie trafiło to od razu do `.env.example`, bo w sesji, w której powstał ten
# system, pliki `.env*` były zablokowane regułami uprawnień — zrób to jednym
# poleceniem wyżej albo skopiuj ręcznie.)

# Folder docelowy na Macu — tu lądują PDF-y i tu Claude sortuje.
# Dostęp Claude'a zapewnia dowiązanie ./notatki tworzone przez setup.sh.
NOTATKI_ROOT=~/Notatki-PDF

# Nazwa konta w Notes.app do eksportu. Puste = wszystkie konta.
NOTATKI_ACCOUNT=iCloud

# Format papieru PDF: A4 albo LETTER.
NOTATKI_PAPER=A4

# Wymuszony zakres eksportu w dniach. Puste = przyrostowo, od ostatniej
# synchronizacji (pierwszy przebieg i tak bierze wszystkie notatki).
NOTATKI_LOOKBACK_DAYS=

# true  = automat (launchd) po eksporcie sam uruchamia Claude Code, który sortuje
#         — działa bez nadzoru człowieka, świadoma decyzja.
# false = PDF-y czekają w 00-inbox na ręczne wywołanie /notatki.
NOTATKI_AUTO_ORGANIZE=false
